{
  "name": "insight-web-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "homepage": "./",
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.94",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@ai-sdk/deepseek": "2.0.45",
    "@ai-sdk/openai": "3.0.81",
    "@ai-sdk/openai-compatible": "2.0.57",
    "ai": "6.0.220",
    "yaml": "2.9.0"
  },
  "scripts": {
    "start": "cross-env HOST=127.0.0.1 DISABLE_ESLINT_PLUGIN=true REACT_APP_ACP_CAPABILITY_TOKEN=msinsight-local-development-only craco start",
    "server": "cross-env ACP_CAPABILITY_TOKEN=msinsight-local-development-only ACP_ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010 node server/index.mjs --host 127.0.0.1 --port 9090",
    "server:build": "node scripts/build-server.mjs",
    "server:build:test": "node --test server/test/integration/nativeAgentPackagedEntry.test.mjs",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true craco build"
  },
  "jest": {
    "moduleNameMapper": {
      "^@insight/lib$": "<rootDir>/../lib/src",
      "^@insight/lib/(.*)$": "<rootDir>/../lib/src/$1"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
