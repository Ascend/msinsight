{
  "name": "@insight/framework",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "homepage": "./",
  "scripts": {
    "build:vscode": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production REACT_APP_IS_VSCODE=true DISABLE_ESLINT_PLUGIN=true GENERATE_SOURCEMAP=false CI=false craco build && node ../inline-build.js",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider REACT_APP_ENV=development craco start",
    "staging": "cross-env NODE_OPTIONS=--openssl-legacy-provider craco start",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production GENERATE_SOURCEMAP=false CI=false craco build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "@insight/lib/FrontendAgentCommand": "<rootDir>/../lib/src/FrontendAgentCommand/index.ts",
      "@insight/lib/WindowMessageRouter": "<rootDir>/../lib/src/WindowMessageRouter/index.ts"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
